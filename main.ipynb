    "        error_buffer = io.StringIO()\n",
    "        \n",
    "        def _run_captured():\n",
    "            with contextlib.redirect_stdout(output_buffer), contextlib.redirect_stderr(error_buffer):\n",
    "                exec(code_str, self.globals)\n",
