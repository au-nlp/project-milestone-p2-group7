    "        print(f\"Verifier Verdict: {'VALID' if is_valid else 'INVALID'} ({verifier_json.get('error_category')})\")\n",
    "            \n",
    "        if is_valid:\n",
    "            return current_solution, all_tries\n",
    "                \n",
    "        # 3. Planning Step \n",
