    "            problem_sandbox\n",
    "        )\n",
    "        trace += f\"\\n\\n--- Correction {i} ---\\n{new_trace}\"\n",
    "\n",
    "        # Store this new attempt\n",
    "        new_try = {\n",
    "            \"turn\": i,\n",
    "            \"solution_text\": current_solution,\n",
    "            \"full_trace\": new_trace,\n",
    "            \"verifier_json\": None,\n",
    "            \"planner_instruction\": None\n",
    "        }\n",
    "        all_tries.append(new_try)\n",
    "            \n",
    "            \n",
    "    return current_solution, all_tries"
